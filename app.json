{
  "expo": {
    "name": "Crocat",
    "slug": "crocat",
    "version": "1.4.7",
    "scheme": "crocat",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/crocat"
    }
  }
}
